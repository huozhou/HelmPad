<?xml version="1.0" encoding="utf-8"?>
<!-- Helm Pad launcher background: top-left → bottom-right linear gradient.
     ShapeDrawable angle=315 equals "top-left → bottom-right" in Android's
     quadrant convention, matching the reference SVG gradient direction. A
     solid fallback @color/ic_launcher_background is still defined in colors.xml
     for any legacy renderer that fails to parse this gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@color/launcher_background_start"
        android:endColor="@color/launcher_background_end"
        android:angle="315"
        android:type="linear" />
</shape>
