<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-drawn glyph, not an Anysphere / Cursor brand asset. See NOTICE.md.
  Shape: a rounded terminal frame overlaid with an I-beam text cursor —
  evokes "Cursor" (editor cursor in a terminal-style frame) without
  copying any real Anysphere trademarks. Tinted by the caller
  (typically `onSurfaceVariant`).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Terminal frame: rounded 20×14 rectangle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M4,6 L20,6 A2,2 0 0 1 22,8 L22,18 A2,2 0 0 1 20,20 L4,20 A2,2 0 0 1 2,18 L2,8 A2,2 0 0 1 4,6 Z" />
    <!-- I-beam text cursor: top serif -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M10,10 L14,10" />
    <!-- I-beam text cursor: vertical stroke -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M12,10 L12,16" />
    <!-- I-beam text cursor: bottom serif -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M10,16 L14,16" />
</vector>
