    <!-- 设置 → 当前 profile 卡片。说明这一版内置的是哪个预设，并提示
         自定义 profile 是规划中的扩展，不是当前能力。 -->
    <string name="settings_profile_section">当前 profile</string>
    <string name="settings_profile_name_label">名称</string>
    <string name="settings_profile_origin_label">来源</string>
    <string name="settings_profile_origin_built_in">内置（随 APK 一起发布）</string>
    <string name="settings_profile_about_label">说明</string>
    <string name="settings_profile_about_claude_code">为 Claude Code 调校的 8 个宏：Approve、Esc、Cycle mode、↑、Switch model、New session、Compact、↓。</string>
    <string name="settings_profile_future_label">后续</string>
    <string name="settings_profile_future_body">自定义 profile（自己定标签、自己定按键）会在后续版本支持。</string>

    <!-- 设置 → 重跑向导的确认弹窗。该动作只是把"引导已完成"标记重置，
         已配对主机、每台设备的目标系统都不会被清。这里把范围说清楚，
         避免按钮名让人误以为会清数据。 -->
    <string name="settings_rerun_confirm_title">重新走一遍向导？</string>
    <string name="settings_rerun_confirm_body">会回到 5 步欢迎流程（权限 → 蓝牙 → 配对 → 电量 → 主机系统）。已配对的电脑和每台设备的系统选择都会保留，不会被删除。</string>
    <string name="settings_rerun_confirm_button">重跑向导</string>

    <!-- 设置 → 关于卡片。展示当前应用版本，便于上报问题时提供。
         长按可复制完整版本字符串。括号内是 versionCode，用于精准定位。 -->
    <string name="settings_about_section">关于</string>
    <string name="settings_about_version_label">版本</string>
