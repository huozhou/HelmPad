    <!-- 向导 – 介绍 -->
    <string name="onboarding_intro_title">为 vibe coding 定制的蓝牙键鼠</string>
    <string name="onboarding_intro_body">Helm Pad 把手机变成通用蓝牙键盘 + 触控板，兼顾 Mac 与 Windows。首发内置 Claude Code profile——批准、中断、切模型都在手边；后续会加入更多编码场景的 profile。接下来 5 步授权、配对、选目标系统，就能开始用了。</string>

    <!-- 向导 – 进度 -->
    <string name="onboarding_step_counter">第 %1$d 步 / 共 %2$d 步</string>

    <!-- 向导 – 权限 -->
    <string name="onboarding_perm_title">授予蓝牙权限</string>
    <string name="onboarding_perm_body">Android 12 及以上需要运行时授予蓝牙权限：Connect 用于发送键鼠事件，Advertise 让电脑能发现它。</string>
    <string name="onboarding_perm_ok">所需权限已全部授予。</string>
    <string name="onboarding_perm_pending">还有未授予的权限。</string>
    <string name="onboarding_perm_request">授予权限</string>

    <!-- 向导 – 蓝牙 -->
    <string name="onboarding_bt_title">打开蓝牙</string>
    <string name="onboarding_bt_body">配对前需要打开手机蓝牙。如果已经是开的，直接点下一步。</string>
    <string name="onboarding_bt_ok">蓝牙已打开。</string>
    <string name="onboarding_bt_pending">蓝牙当前是关闭的。</string>
    <string name="onboarding_bt_open">打开蓝牙设置</string>

    <!-- 向导 – 配对 -->
    <string name="onboarding_pair_title">和电脑配对</string>
    <string name="onboarding_pair_body">在 Mac 或 PC 的蓝牙面板上添加设备，然后用下方按钮跳到 Android 蓝牙设置完成配对。完成后会自动识别。</string>
    <string name="onboarding_pair_open_settings">打开 Android 蓝牙设置</string>
    <string name="onboarding_pair_waiting">等待新配对设备出现…</string>
    <string name="onboarding_pair_pick">选中刚才配对的电脑</string>

    <!-- 向导 – 电量 -->
    <string name="onboarding_battery_title">让后台连接保持存活</string>
    <string name="onboarding_battery_body">Android 激进的省电机制会在屏幕休眠后杀掉 HID 连接。把 Helm Pad 加入电量优化白名单能让它持续运行。这一步可以跳过，之后也能重新开启。</string>
    <string name="onboarding_battery_open">跳转到电量优化设置</string>

    <!-- 向导 – 主机目标 -->
    <string name="onboarding_target_title">这台电脑是什么系统？</string>
    <string name="onboarding_target_body">选对之后，Cmd / Ctrl 等快捷键才能正确映射。之后可以在设置里改。</string>
    <string name="onboarding_target_body_with_host">记住 \"%1$s\" 的目标系统，下次连接会自动套用。</string>

    <!-- 向导 – 导航按钮 -->
    <string name="onboarding_next">下一步</string>
    <string name="onboarding_back">返回</string>
    <string name="onboarding_finish">完成</string>

