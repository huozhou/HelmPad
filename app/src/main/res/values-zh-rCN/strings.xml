    <string name="settings_about_version_value_debug">%1$s（%2$d）· debug</string>
    <string name="settings_about_version_copied">版本号已复制</string>

    <!-- 通知 -->
    <string name="notification_channel_name">HID 连接</string>
    <string name="notification_channel_description">在后台保持蓝牙键盘 / 鼠标连接。</string>
    <string name="notification_title">Helm Pad 已连接</string>
    <string name="notification_text_connected">已连接到 %1$s</string>
