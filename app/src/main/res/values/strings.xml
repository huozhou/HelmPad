    <string name="onboarding_pair_waiting">Waiting for a new paired device…</string>
    <string name="onboarding_pair_pick">Choose the host you just paired with</string>

    <!-- Onboarding – battery -->
    <string name="onboarding_battery_title">Keep the link alive in the background</string>
    <string name="onboarding_battery_body">Without an exemption, Android may kill the HID link when the screen sleeps. Skippable — you can enable this later.</string>
    <string name="onboarding_battery_open">Request battery exemption</string>

