    <!-- Settings → Active profile. Dropdown row (leading icon + current name +
         chevron) that expands a DropdownMenu listing every bundled profile,
         with a check-mark trailing icon on the current selection. -->
    <string name="settings_profile_section">Active profile</string>
    <string name="settings_profile_dropdown_row_cd">Active profile: %1$s. Tap to choose a different profile.</string>
    <string name="settings_profile_dropdown_selected_cd">Currently selected</string>
    <string name="settings_profile_about_label">About</string>
    <string name="settings_profile_about_claude_code">Tuned for Claude Code. Eight macros on the operator grid.</string>
    <string name="settings_profile_about_codex">Tuned for the `codex` CLI and the Codex app. Shift+Tab cycles approval modes.</string>
    <string name="settings_profile_about_cursor">Tuned for Cursor desktop chat and agent mode. Uses Cursor\'s default VS Code shortcuts.</string>

    <!-- Settings → Re-run setup confirmation. The action only resets the
         onboarding-complete flag; paired hosts and per-device OS choices
         survive. We surface that explicitly because the button name sounds
         scarier than the actual blast radius. -->
    <string name="settings_rerun_confirm_title">Re-run the setup wizard?</string>
    <string name="settings_rerun_confirm_body">You\'ll be sent back to the 6-step welcome flow (permissions → Bluetooth → pairing → battery → host OS → default agent). Your paired computers and per-device OS choices stay as they are; nothing gets deleted.</string>
    <string name="settings_rerun_confirm_button">Re-run setup</string>

    <!-- Settings → About card. Shows the app version so the user can quote it
         when reporting issues. Long-press copies the full string to clipboard.
         versionCode is in parentheses because users mostly care about the
         semver label; the integer is there for bug-report cross-reference. -->
    <string name="settings_about_section">About</string>
    <string name="settings_about_version_label">Version</string>
    <string name="settings_about_version_value">%1$s (%2$d)</string>
    <string name="settings_about_version_value_debug">%1$s (%2$d) · debug</string>
    <string name="settings_about_version_copied">Version copied</string>

